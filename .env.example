# LLM Provider Orchestration
LLM_PRIMARY_PROVIDER=cerebras

# Cerebras Cloud (primary)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_MAX_COMPLETION_TOKENS=1024
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_TOP_P=1

# OpenRouter (first fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.1

# Optional metadata headers for OpenRouter
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_SITE_NAME=Cerebro Backend

# Optional additional fallbacks
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Groq schema limits
GROQ_SCHEMA_MAX_CHARS=7000
GROQ_SCHEMA_RAG_MAX_SECTIONS=6
GROQ_SCHEMA_RAG_MAX_CHARS=4500

# Optional explicit schema context file path
# Default is local file: SCHEMA_CONTEXT_FOR_LLM.md in backend root.
# SCHEMA_CONTEXT_PATH=/opt/render/project/src/SCHEMA_CONTEXT_FOR_LLM.md

# Neo4j Aura Database
NEO4J_URI=neo4j+s://0d8a4c43.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=20
NEO4J_MAX_RESULT_ROWS=500

# FastAPI
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# Web Search APIs
FIRECRAWL_API_KEY=your_firecrawl_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional runtime toggle
# Set to false for DB-only testing without Tavily/Firecrawl enrichment.
WEB_ENRICHMENT_ENABLED=true
