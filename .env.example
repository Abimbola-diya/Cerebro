# Provider priority: OpenRouter/Cerebras primary, Gemini fallback, GitHub last-resort.
# GitHub Models
# Token should have models:read permission
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Groq fallback (DeepSeek R1 Distill)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter reasoning fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Cerebro-Planner
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_REASONING_MAX_TOKENS=1024
OPENROUTER_MAX_TOKENS=1200

# Cerebras fallback
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# DeepSeek direct
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# NVIDIA NIM direct
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=1400
NVIDIA_TEMPERATURE=0.55
NVIDIA_TOP_P=1.0
NVIDIA_RANDOM_SEED=true
NVIDIA_FIXED_SEED=0

# Gemini fallback
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Research tooling (planning stage placeholders)
SERPER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
DUCKDUCKGO_ENABLED=true

# Planner streaming/runtime tuning
PLANNER_STREAM_TIMEOUT_SECONDS=130
PLANNER_TIMEOUT_SECONDS=120
PLANNER_MIN_ATTEMPTS=8
PLANNER_STREAM_EXCLUDE_MODELS=openai/gpt-5
PLANNER_MAX_TOKENS=3200
GITHUB_GPT5_MAX_COMPLETION_TOKENS=2200
