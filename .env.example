# LLM Provider Orchestration
LLM_PRIMARY_PROVIDER=cerebras

# Cerebras Cloud (primary)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_MAX_COMPLETION_TOKENS=1024
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_TOP_P=1

# OpenRouter (first fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.1

# Optional metadata headers for OpenRouter
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_SITE_NAME=Cerebro Backend

# Optional additional fallbacks
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Groq schema limits
GROQ_SCHEMA_MAX_CHARS=7000
GROQ_SCHEMA_RAG_MAX_SECTIONS=6
GROQ_SCHEMA_RAG_MAX_CHARS=4500

# Optional general schema-RAG limits (non-compact providers)
SCHEMA_RAG_DEFAULT_MAX_SECTIONS=10
SCHEMA_RAG_DEFAULT_MAX_CHARS=14000

# Providers that should use compact schema mode (comma-separated)
# Default keeps compact mode only for Groq, while others use query-focused schema context.
LLM_COMPACT_SCHEMA_PROVIDERS=groq

# Enable runtime schema introspection from live Neo4j (recommended)
RUNTIME_SCHEMA_INTROSPECTION_ENABLED=true

# Entity resolution pre-pass (maps user company mentions to canonical IDs before Cypher generation)
ENTITY_RESOLUTION_ENABLED=true
ENTITY_RESOLUTION_MAX_IDS=5
ENTITY_RESOLUTION_MIN_SCORE=100
# Optional typo-tolerance tuning (0..1 similarity thresholds)
ENTITY_RESOLUTION_ALIAS_FUZZY_THRESHOLD=0.80
ENTITY_RESOLUTION_DYNAMIC_FUZZY_THRESHOLD=0.84
ENTITY_RESOLUTION_TOKEN_FUZZY_THRESHOLD=0.82

# Optional explicit schema context file path
# Default is local file: SCHEMA_CONTEXT_FOR_LLM.md in backend root.
# SCHEMA_CONTEXT_PATH=/opt/render/project/src/SCHEMA_CONTEXT_FOR_LLM.md

# Neo4j Aura Database
NEO4J_URI=neo4j+s://0d8a4c43.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=20
NEO4J_MAX_RESULT_ROWS=500

# Runtime schema introspection cache/tuning
SCHEMA_SUMMARY_TTL_SECONDS=900
SCHEMA_SUMMARY_MAX_LABELS=30
SCHEMA_SUMMARY_MAX_PROPERTIES_PER_LABEL=35
SCHEMA_SUMMARY_MAX_RELATIONSHIPS=30
SCHEMA_SUMMARY_MAX_CHARS=18000

# FastAPI
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
# Comma-separated list of allowed frontend origins.
# Example: https://your-frontend.vercel.app,https://staging.your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=*
# Keep false when using wildcard origins.
CORS_ALLOW_CREDENTIALS=false

# Optional backend self-keepalive for free-tier hosts.
# Use your public Render URL so pings pass through the platform edge.
KEEPALIVE_ENABLED=false
KEEPALIVE_TARGET_URL=https://your-service-name.onrender.com
KEEPALIVE_PATH=/health
KEEPALIVE_INTERVAL_SECONDS=540
KEEPALIVE_TIMEOUT_SECONDS=15
KEEPALIVE_STARTUP_DELAY_SECONDS=30
KEEPALIVE_JITTER_SECONDS=20

# Web Search APIs
FIRECRAWL_API_KEY=your_firecrawl_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional extra web providers (free/low-cost tiers available)
SERPER_API_KEY=your_serper_api_key_here
SERPER_MAX_RESULTS=6
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_MAX_RESULTS=8
WIKIPEDIA_ENABLED=true
WIKIPEDIA_MAX_RESULTS=5

# Optional Tavily depth controls
TAVILY_MAX_RESULTS_PER_QUERY=6
TAVILY_QUERY_VARIANTS=2
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
TAVILY_INCLUDE_RAW_CONTENT=true

# Optional Firecrawl/web breadth controls
FIRECRAWL_TIMEOUT_SECONDS=20
WEB_SCRAPE_MAX_SOURCES=8
WEB_DISCOVERED_SOURCES_LIMIT=12
WEB_SCRAPE_BLOCKED_DOMAINS=facebook,twitter,x.com,instagram,tiktok,linkedin
WEB_QUERY_VARIANTS=3
WEB_EXTENSIVE_MODE=true

# Optional runtime toggle
# Set to false for DB-only testing without Tavily/Firecrawl enrichment.
WEB_ENRICHMENT_ENABLED=true
WEB_SOURCES_FOR_SYNTHESIS=12
WEB_SOURCE_MAX_CHARS=2200
WEB_ANSWER_MAX_CHARS=14000
WEB_PRIORITY_MODE=balanced
WEB_MULTI_MODEL_ENABLED=true
WEB_SOURCE_SUMMARY_PROVIDER=auto
WEB_FINAL_SYNTHESIS_PROVIDER=auto

# LangChain schema-aware Cypher shadow mode (recommended for staged rollout)
LANGCHAIN_CYPHER_SHADOW_ENABLED=true
LANGCHAIN_CYPHER_PROVIDER=openrouter
LANGCHAIN_OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
LANGCHAIN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LANGCHAIN_OPENROUTER_TEMPERATURE=0.0
LANGCHAIN_OPENROUTER_MAX_TOKENS=1200
LANGCHAIN_TIMEOUT_SECONDS=35
LANGCHAIN_SCHEMA_MAX_CHARS=18000
LANGCHAIN_SCHEMA_REFRESH_SECONDS=900
LANGCHAIN_INIT_RETRY_SECONDS=120
