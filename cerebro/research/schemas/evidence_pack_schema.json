{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Pack",
  "type": "object",
  "required": ["query", "evidence", "gaps"],
  "properties": {
    "query": {"type": "string"},
    "entity_id": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {"type": "object"}
    },
    "gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}